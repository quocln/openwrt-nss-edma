# Xiaomi CR8806 (M79) alone, for .github/workflows/build-cr8806.yml. The memory settings of the
# "256m" group (256m.config), plus what this one board can afford or needs on top.
CONFIG_NSS_MEM_PROFILE_LOW=y
# NSS firmware 12.2-156, as in the 256m group: 12.5-210 keeps payload buffers with some 802.11ac
# clients (kuncy7/openwrt-nss-edma#64).
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
# Smaller host TX and CE allocations under the Wi-Fi offload. Measured on a CR8806 with 5 GHz
# HE160 and NSS firmware 12.5-210 (fanha99): the lowest MemAvailable under load rose from 0.9 to
# 6.4 MiB. Not measured with 12.2-156.
CONFIG_ATH11K_NSS_MEM_PROFILE_256M=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_cr8806=y

# The first install from stock boots initramfs-uImage.itb over TFTP and writes factory.ubi from
# there, so the build has to produce the initramfs image as well.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# LuCI over plain HTTP.
CONFIG_PACKAGE_luci=y

# The board has no USB connector, so no external storage either. The target's default packages
# are already =y by the time a board's own "-package" list is read, so they are switched off here
# (kmod-usb3, -dwc3 and -dwc3-qcom with the four they depend on: 256 KiB of modules with no user;
# ext4, jbd2 and mbcache another 540 KiB).
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# CONFIG_PACKAGE_kmod-usb-roles is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_losetup is not set
