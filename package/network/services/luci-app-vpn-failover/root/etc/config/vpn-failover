config failover 'main'
	# seconds between two checks of the tunnel
	option interval '10'
	# failed checks in a row before the house falls back to the ISP connection
	option down_after '3'
	# good checks in a row before it goes into the tunnel
	option up_after '2'
	# pinged through the tunnel; one answer is enough
	list probe_target '1.1.1.1'
	list probe_target '8.8.8.8'
	# 1: while a VPN is connected the router asks that VPN's DNS server; 0: always its normal ones
	option vpn_dns '1'
	# LAN addresses of devices that always use the ISP connection:
	# list direct_ip '192.168.7.50'
	# all: everything goes through the VPN, except the websites in "list direct_site";
	# listed: only the websites in "list vpn_site" go through it. A name covers its sub-names.
	option site_mode 'all'
	# list direct_site 'example.vn'
	# list vpn_site 'example.com'

# "option active" names the VPN in use, one of the files /etc/vpn-failover/vpn<N>.conf that
# "vpn-failover add <file>" (or the LuCI page VPN, House VPN) keeps. Set by "vpn-failover use".
